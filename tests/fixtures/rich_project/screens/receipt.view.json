{
  "id": "receipt.view",
  "title": "Receipt",
  "kind": "result",
  "audience": "private",
  "message": {
    "id": "main",
    "format": "rich.html",
    "text": {
      "en": "<h3>Order #{order.no} <tg-button type=\"copy_text\" text=\"{order.no}\">Copy</tg-button></h3><table compact><tr><th>Item</th><th>Price</th></tr><tr><td>Latte</td><td>$4.50</td></tr></table><p>Total <b>{order.total}</b>. <tg-button action=\"why\"></tg-button></p>",
      "ru": "<h3>Заказ #{order.no} <tg-button type=\"copy_text\" text=\"{order.no}\">Скопировать</tg-button></h3><p>Итого <b>{order.total}</b>. <tg-button action=\"why\"></tg-button></p>"
    }
  },
  "keyboard": {
    "type": "inline",
    "rows": [
      [
        "pay"
      ],
      [
        "track",
        "back"
      ]
    ]
  },
  "actions": {
    "why": {
      "label": {
        "en": "Why this price?",
        "ru": "Почему такая цена?"
      },
      "type": "answer",
      "style": "link",
      "text": {
        "en": "Delivery is included",
        "ru": "Доставка включена"
      }
    },
    "pay": {
      "label": {
        "en": "Pay {order.total}",
        "ru": "Оплатить {order.total}"
      },
      "type": "navigate",
      "to": "receipt.paid",
      "style": "success"
    },
    "track": {
      "label": {
        "en": "Track",
        "ru": "Отследить"
      },
      "type": "url",
      "url": "https://example.com/track?a=1&b=2"
    },
    "back": {
      "label": {
        "en": "Menu",
        "ru": "Меню"
      },
      "type": "back",
      "fallback": "receipt.view"
    }
  }
}
